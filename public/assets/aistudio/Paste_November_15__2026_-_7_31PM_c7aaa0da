<script>
    let selectedCount = 6;
    let unitPrice = 14.90;

    function updateCartSelection(checkbox, price) {
      if (checkbox.checked) {
        selectedCount++;
      } else {
        selectedCount = Math.max(0, selectedCount - 1);
      }
      refreshCartUI();
    }

    function selectAllPhotos(checkState) {
      const checkboxes = document.querySelectorAll('#photo-grid input[type="checkbox"]');
      checkboxes.forEach(cb => cb.checked = checkState);
      selectedCount = checkState ? checkboxes.length : 0;
      refreshCartUI();
    }

    function refreshCartUI() {
      const total = (selectedCount * unitPrice).toFixed(2).replace('.', ',');
      document.getElementById('cart-counter-badge').innerText = selectedCount;
      document.getElementById('dock-counter').innerText = `${selectedCount} fotos selecionadas`;
      document.getElementById('dock-price').innerText = `R$ ${total}`;
    }

    // Lightbox Logic
    function openLightbox(id, match, title, photographer) {
      document.getElementById('lb-match-pill').innerText = match + ' Match';
      document.getElementById('lb-title').innerText = title;
      document.getElementById('lb-photographer').innerText = photographer;
      const modal = document.getElementById('lightbox-modal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeLightbox() {
      const modal = document.getElementById('lightbox-modal');
      modal.classList.remove('flex');
      modal.classList.add('hidden');
    }

    // Checkout Modal Logic
    function openCheckoutModal(type, price, count) {
      const modal = document.getElementById('checkout-modal');
      const titleElem = document.getElementById('modal-product-title');
      const priceElem = document.getElementById('modal-product-price');

      if (type === 'pacote-completo') {
        titleElem.innerText = `Pacote Completo Sobral Online Run (${count} Fotos)`;
        priceElem.innerText = `R$ ${price.toFixed(2).replace('.', ',')}`;
      } else if (type === 'fotos-selecionadas') {
        titleElem.innerText = `Seleção de Fotos do Atleta (${selectedCount} Fotos)`;
        const computed = (selectedCount * unitPrice).toFixed(2).replace('.', ',');
        priceElem.innerText = `R$ ${computed}`;
      } else {
        titleElem.innerText = `Foto Individual em Alta Resolução (300 DPI)`;
        priceElem.innerText = `R$ ${price.toFixed(2).replace('.', ',')}`;
      }

      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeCheckoutModal() {
      const modal = document.getElementById('checkout-modal');
      modal.classList.remove('flex');
      modal.classList.add('hidden');
    }

    function toggleCheckoutDrawer() {
      openCheckoutModal('fotos-selecionadas', 89.40, selectedCount);
    }

    function switchPayment(method) {
      const pixView = document.getElementById('payment-pix-view');
      const cardView = document.getElementById('payment-card-view');
      const btnPix = document.getElementById('btn-tab-pix');
      const btnCard = document.getElementById('btn-tab-card');

      if (method === 'pix') {
        pixView.classList.remove('hidden');
        cardView.classList.add('hidden');
        btnPix.classList.add('border-primary-container', 'bg-primary-fixed/20', 'text-on-surface');
        btnPix.classList.remove('border-outline-variant/40', 'bg-surface-card', 'text-secondary');
        btnCard.classList.remove('border-primary-container', 'bg-primary-fixed/20', 'text-on-surface');
        btnCard.classList.add('border-outline-variant/40', 'bg-surface-card', 'text-secondary');
      } else {
        pixView.classList.add('hidden');
        cardView.classList.remove('hidden');
        btnCard.classList.add('border-primary-container', 'bg-primary-fixed/20', 'text-on-surface');
        btnCard.classList.remove('border-outline-variant/40', 'bg-surface-card', 'text-secondary');
        btnPix.classList.remove('border-primary-container', 'bg-primary-fixed/20', 'text-on-surface');
        btnPix.classList.add('border-outline-variant/40', 'bg-surface-card', 'text-secondary');
      }
    }

    function copyPixCode() {
      const txt = document.getElementById('pix-copy-text');
      txt.innerText = 'Código Pix Copiado com Sucesso!';
      setTimeout(() => {
        txt.innerText = 'Copiar Código Pix Copia e Cola';
      }, 3000);
    }
  </script>
