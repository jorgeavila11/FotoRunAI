# ---------------------------------------------------------------
# Copie este arquivo para ".env" e preencha os valores.
# NUNCA publique o arquivo .env (ele já está no .gitignore).
# ---------------------------------------------------------------

# GEMINI_API_KEY: leitura de número de peito e busca facial.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Modelos do Gemini em ordem de preferência (opcional). Se um estiver sobrecarregado ou lento,
# o servidor tenta o próximo. Veja os disponíveis com "npm run check:gemini".
# GEMINI_MODELS="gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite"

# APP_URL: endereço onde o site está publicado.
APP_URL="MY_APP_URL"

# --- Supabase (Dashboard > Project Settings > API) ---
# Usadas pelo NAVEGADOR (públicas, podem aparecer no site):
VITE_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
VITE_SUPABASE_ANON_KEY="sua-chave-anon-public"

# Usadas SÓ PELO SERVIDOR (secretas!):
SUPABASE_URL="https://SEU-PROJETO.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="sua-chave-service_role"

# E-mail do fotógrafo de demonstração criado por "npm run seed" (opcional)
# DEMO_PHOTOGRAPHER_EMAIL="fotografo.demo@fotorun.app"
